{
  "name": "launcher-app",
  "version": "1.1.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "node scripts/selftest.js",
    "smoke": "electron scripts/smoke-electron.js",
    "smoke:steam": "electron scripts/smoke-steam.js",
    "screenshots": "electron scripts/screenshots.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "electron-builder --win dir --x64 --publish never",
    "dist:check": "node scripts/check-dist.js",
    "dist:installer": "node scripts/build-installer.js"
  },
  "keywords": [],
  "author": "Sentient Solutions",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^36.2.0",
    "electron-builder": "25.1.8",
    "rcedit": "4.0.1"
  },
  "dependencies": {
    "ansi-regex": "^5.0.1",
    "ansi-styles": "^4.3.0",
    "boolean": "^3.2.0",
    "buffer-crc32": "^0.2.13",
    "cacheable-lookup": "^5.0.4",
    "cacheable-request": "^7.0.4",
    "chalk": "^4.1.2",
    "cliui": "^8.0.1",
    "clone-response": "^1.0.3",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "debug": "^4.4.0",
    "decompress-response": "^6.0.0",
    "defer-to-connect": "^2.0.1",
    "define-data-property": "^1.1.4",
    "define-properties": "^1.2.1",
    "detect-node": "^2.1.0",
    "electron-updater": "~6.3.9",
    "emoji-regex": "^8.0.0",
    "end-of-stream": "^1.4.4",
    "env-paths": "^2.2.1",
    "es-define-property": "^1.0.1",
    "es-errors": "^1.3.0",
    "es6-error": "^4.1.1",
    "escalade": "^3.2.0",
    "escape-string-regexp": "^4.0.0",
    "extract-zip": "^2.0.1",
    "fd-slicer": "^1.1.0",
    "fs-extra": "^8.1.0",
    "get-caller-file": "^2.0.5",
    "get-stream": "^5.2.0",
    "global-agent": "^3.0.0",
    "globalthis": "^1.0.4",
    "gopd": "^1.2.0",
    "got": "^11.8.6",
    "graceful-fs": "^4.2.11",
    "has-flag": "^4.0.0",
    "has-property-descriptors": "^1.0.2",
    "http-cache-semantics": "^4.2.0",
    "http2-wrapper": "^1.0.3",
    "is-fullwidth-code-point": "^3.0.0",
    "json-buffer": "^3.0.1",
    "json-stringify-safe": "^5.0.1",
    "jsonfile": "^4.0.0",
    "keyv": "^4.5.4",
    "lodash": "^4.17.21",
    "lowercase-keys": "^2.0.0",
    "matcher": "^3.0.0",
    "mimic-response": "^1.0.1",
    "ms": "^2.1.3",
    "normalize-url": "^6.1.0",
    "object-keys": "^1.1.1",
    "once": "^1.4.0",
    "p-cancelable": "^2.1.1",
    "pend": "^1.2.0",
    "progress": "^2.0.3",
    "pump": "^3.0.2",
    "quick-lru": "^5.1.1",
    "require-directory": "^2.1.1",
    "resolve-alpn": "^1.2.1",
    "responselike": "^2.0.1",
    "roarr": "^2.15.4",
    "rxjs": "^7.8.2",
    "semver": "^6.3.1",
    "semver-compare": "^1.0.0",
    "serialize-error": "^7.0.1",
    "shell-quote": "^1.8.2",
    "sprintf-js": "^1.1.3",
    "steamworks.js": "^0.4.0",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "sumchecker": "^3.0.1",
    "supports-color": "^8.1.1",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
    "type-fest": "^0.13.1",
    "undici-types": "^6.21.0",
    "universalify": "^0.1.2",
    "wrap-ansi": "^7.0.0",
    "wrappy": "^1.0.2",
    "y18n": "^5.0.8",
    "yargs": "^17.7.2",
    "yargs-parser": "^21.1.1",
    "yauzl": "^2.10.0"
  },
  "description": "SS Game Launcher for THE GREAT CIRCLE",
  "build": {
    "appId": "com.sentientsolutions.tgc.launcher",
    "productName": "SS Game Launcher",
    "executableName": "TGC_Launcher",
    "copyright": "Sentient Solutions",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "termainejenkins",
        "repo": "SS_GameLauncher",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "updater.js",
      "preload.js",
      "renderer.js",
      "account.js",
      "config.js",
      "game-launch.js",
      "steam-ticket-worker.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "package.json",
      "!node_modules/steamworks.js/dist/linux64/**",
      "!node_modules/steamworks.js/dist/osx/**",
      "!node_modules/steamworks.js/dist/win64/*.lib"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "extraFiles": [
      {
        "from": "build/launcher-config.json",
        "to": "launcher-config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/brand/ss_appicon_win_multi_v2.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "build/afterPack.js",
    "electronLanguages": [
      "en-US"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SS Game Launcher",
      "uninstallDisplayName": "SS Game Launcher",
      "artifactName": "SS_GameLauncher-Setup-${version}.${ext}",
      "installerIcon": "assets/brand/ss_appicon_win_multi_v2.ico",
      "uninstallerIcon": "assets/brand/ss_appicon_win_multi_v2.ico"
    }
  }
}
